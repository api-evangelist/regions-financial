{
  "opencollection": "1.0.0",
  "info": {
    "name": "Regions Open Banking Account Information Consent API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.regions.com/oauth/authorize",
      "accessTokenUrl": "https://auth.regions.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Consent",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Consents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.regions.com/v1/consents"
          },
          "docs": "List active data sharing consents granted by the customer."
        },
        {
          "info": {
            "name": "Revoke Consent",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.regions.com/v1/consents/:consentId",
            "params": [
              {
                "name": "consentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Revoke a specific data sharing consent."
        }
      ]
    }
  ],
  "bundled": true
}