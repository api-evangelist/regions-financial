{
  "opencollection": "1.0.0",
  "info": {
    "name": "Regions Open Banking Account Information API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.regions.com/oauth/authorize",
      "accessTokenUrl": "https://auth.regions.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.regions.com/v1/accounts",
            "params": [
              {
                "name": "accountType",
                "value": "",
                "type": "query",
                "description": "Filter by account type"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by account status"
              }
            ]
          },
          "docs": "Retrieve a list of accounts for the authenticated customer, including checking, savings, credit card, loan, and investment accounts."
        },
        {
          "info": {
            "name": "Get Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.regions.com/v1/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique account identifier"
              }
            ]
          },
          "docs": "Retrieve details for a specific account."
        }
      ]
    }
  ],
  "bundled": true
}